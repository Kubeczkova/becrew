{
  "name": "portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "pnpm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx src/lib/server/db/seed.ts",
    "db:seed-themes": "npx tsx src/lib/server/db/seed-theme.ts",
    "gen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.18.0",
    "@fontsource/fira-mono": "^5.0.0",
    "@neoconfetti/svelte": "^2.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^4.0.0",
    "svelte": "^5.25.0",
    "svelte-check": "^4.0.0",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.4",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.0.0",
    "drizzle-orm": "^0.45.0",
    "flag-icons": "^7.5.0",
    "postgres": "^3.4.5",
    "svelte-i18n": "^4.0.1"
  }
}
